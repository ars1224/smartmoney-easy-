
# SmartMoney! Easy - Backend Environment Template
# Copy this file to .env and configure your own values.
# Never commit the actual .env file.

# PostgreSQL
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/smartmoney_easy

# Flask Authentication
SECRET_KEY=REPLACE_WITH_YOUR_RANDOM_SECRET_KEY

# Local HTTP development only.
# Must be true in production over HTTPS.
SESSION_COOKIE_SECURE=false

# Mock Bank API
MOCK_BANK_API_BASE_URL=http://127.0.0.1:5001/api/v1
MOCK_BANK_API_KEY=REPLACE_WITH_YOUR_MOCK_BANK_API_KEY

# Mock Bank OAuth 2.0
MOCK_BANK_OAUTH_CLIENT_ID=smartmoney-easy
MOCK_BANK_OAUTH_REDIRECT_URI=http://localhost:8100/bank/callback

# Fernet Encryption Key
BANK_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_YOUR_VALID_FERNET_KEY
